{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/login",
      "destination": "/start/login.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/start/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/watch/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/start",
      "destination": "/start/index.html"
    }
  ]
}
