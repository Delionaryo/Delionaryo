{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/login",
      "destination": "https://hub.gapcreation.space",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/start/icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/start/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/start/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/open",
      "destination": "/api/meta-gateway"
    },
    {
      "source": "/fb",
      "destination": "/api/meta-gateway"
    },
    {
      "source": "/messenger",
      "destination": "/api/meta-gateway"
    },
    {
      "source": "/delionaryo-app",
      "destination": "/api/start-app"
    },
    {
      "source": "/open-delionaryo",
      "destination": "/api/start-app"
    },
    {
      "source": "/share",
      "destination": "/api/start-app"
    },
    {
      "source": "/install",
      "destination": "/api/start-app"
    },
    {
      "source": "/promo",
      "destination": "/api/promo"
    },
    {
      "source": "/start/manifest.webmanifest",
      "destination": "/api/start-manifest"
    },
    {
      "source": "/start/sw.js",
      "destination": "/api/start-sw"
    },
    {
      "source": "/start/index.html",
      "destination": "/api/start-app"
    },
    {
      "source": "/start/",
      "destination": "/api/start-app"
    },
    {
      "source": "/start",
      "destination": "/api/start-app"
    }
  ]
}
