{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/login",
      "destination": "https://hub.gapcreation.space",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/open",
      "destination": "/api/meta-gateway"
    },
    {
      "source": "/fb",
      "destination": "/api/meta-gateway"
    },
    {
      "source": "/messenger",
      "destination": "/api/meta-gateway"
    },
    {
      "source": "/delionaryo-app",
      "destination": "/api/start-app"
    },
    {
      "source": "/open-delionaryo",
      "destination": "/api/start-app"
    },
    {
      "source": "/share",
      "destination": "/api/start-app"
    },
    {
      "source": "/install",
      "destination": "/api/start-app"
    },
    {
      "source": "/promo",
      "destination": "/api/promo"
    },
    {
      "source": "/start/manifest.webmanifest",
      "destination": "/api/start-manifest"
    },
    {
      "source": "/start/sw.js",
      "destination": "/api/start-sw"
    },
    {
      "source": "/start/icon.png",
      "destination": "https://raw.githubusercontent.com/Delionaryo/Delionaryo/main/public/start/ChatGPT%20Image%20Sep%206%2C%202026%2C%2004_07_56%20PM.png"
    },
    {
      "source": "/start/index.html",
      "destination": "/api/start-app"
    },
    {
      "source": "/start/",
      "destination": "/api/start-app"
    },
    {
      "source": "/start",
      "destination": "/api/start-app"
    }
  ]
}
